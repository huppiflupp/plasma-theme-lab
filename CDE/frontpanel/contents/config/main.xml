<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="visibilityMode" type="Int"><default>0</default></entry>
    <entry name="topEdge" type="Bool"><default>false</default></entry>
    <!-- 0 bottom, 1 top, 2 left, 3 right; -1 follows topEdge (0.2.0 settings) -->
    <entry name="edge" type="Int"><default>-1</default></entry>
    <entry name="windowsOnThisScreen" type="Bool"><default>true</default></entry>
    <!-- The workspace switcher, and how many workspaces it keeps in KWin (1-8) -->
    <entry name="showWorkspaces" type="Bool"><default>true</default></entry>
    <entry name="workspaceCount" type="Int"><default>4</default></entry>
    <!-- Width of one workspace button in console units, and labels per workspace (empty: the number) -->
    <entry name="workspaceButtonWidth" type="Int"><default>70</default></entry>
    <entry name="workspaceLabels" type="StringList"><default></default></entry>
    <!-- Workspace buttons in the palette's colour sets 3, 5, 6, 7, as in CDE -->
    <entry name="workspaceColours" type="Bool"><default>true</default></entry>
    <!-- Windows of one application as one task button: "3× Konsole" -->
    <entry name="groupWindows" type="Bool"><default>true</default></entry>
    <!-- Open windows: "strip" under the tiles, or a window tile with a list
         beside the launchers, "tileLeft" or "tileRight", or "workspaces", icons
         under each workspace's button (no strip, a lower console) -->
    <entry name="windowDisplay" type="String"><default>strip</default></entry>
    <entry name="consoleLabel" type="String"><default>CDE / COPPER</default></entry>
    <entry name="consoleScale" type="Double"><default>1.0</default></entry>
    <!-- The console shows the volume; keep the tray from showing it twice -->
    <entry name="hideTrayVolume" type="Bool"><default>true</default></entry>
    <!-- Tray entries only behind the console's hidden-icons button -->
    <entry name="hideTrayIcons" type="Bool"><default>true</default></entry>
    <!-- Tray entries the console hid itself, taken out again when switched off -->
    <entry name="trayHiddenByConsole" type="StringList"><default></default></entry>
    <!-- The Plasma panel's own frame around the console -->
    <entry name="panelFrame" type="Bool"><default>false</default></entry>
    <!-- Text in pure black (white on dark surfaces) instead of the palette's -->
    <entry name="hardContrast" type="Bool"><default>false</default></entry>
    <!-- Floating: a gap to the screen edge; off, the console sits on the edge -->
    <entry name="floating" type="Bool"><default>true</default></entry>
    <!-- One console for all screens, or one per screen (cdecopperrc too) -->
    <entry name="everyScreen" type="Bool"><default>false</default></entry>
    <!-- Written by the Style page; the console applies it (JSON: palette, backdrop, scale) -->
    <entry name="styleRequest" type="String"><default></default></entry>
  </group>
  <group name="Launchers">
    <!-- JSON lists of {label, icon, command, menu}; empty means the defaults in launch.js -->
    <!-- Launcher tiles with a label under the icon, or the icon alone, larger -->
    <entry name="launcherLabels" type="Bool"><default>true</default></entry>
    <entry name="leftLaunchers" type="String"><default></default></entry>
    <entry name="rightLaunchers" type="String"><default></default></entry>
  </group>
  <group name="Clock">
    <entry name="clockOpensApp" type="Bool"><default>false</default></entry>
    <!-- digital, segments, analog; the dial for analog: cde, motif, roman, plain -->
    <entry name="clockStyle" type="String"><default>digital</default></entry>
    <entry name="clockDial" type="String"><default>cde</default></entry>
    <entry name="clockSeconds" type="Bool"><default>false</default></entry>
    <entry name="clockSegmentEdge" type="Bool"><default>false</default></entry>
    <entry name="clockSegmentShadow" type="Bool"><default>true</default></entry>
    <entry name="calendarCommand" type="String"><default>@calendar</default></entry>
    <entry name="enabledCalendarPlugins" type="StringList"><default>pimevents</default></entry>
  </group>
</kcfg>
