      "background-color": "#31436f"
    },
    "Warning": {
      "text-color": "#eaccb2",
      "selected-text-color": "#ffffff",
      "bold": true
    },
    "Alert": {
      "text-color": "#ffffff",
      "selected-text-color": "#ffffff",
      "bold": true,
      "background-color": "#762725"
    },
    "Error": {
      "text-color": "#edc7c7",
      "selected-text-color": "#ffffff",
      "underline": true
    }
  },
