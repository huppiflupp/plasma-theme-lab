      "text-color": "#eaccb2",
      "selected-text-color": "#ffffff"
    },
    "Constant": {
      "text-color": "#eaccb2",
      "selected-text-color": "#ffffff"
    },
    "String": {
      "text-color": "#edc7c7",
      "selected-text-color": "#ffffff"
    },
    "VerbatimString": {
      "text-color": "#edc7c7",
      "selected-text-color": "#ffffff"
    },
    "Char": {
      "text-color": "#ebcae1",
