  "text-styles": {
    "Normal": {
      "text-color": "#ffffff",
      "selected-text-color": "#ffffff",
      "bold": false,
      "italic": false,
      "underline": false,
      "strike-through": false
    },
    "Keyword": {
      "text-color": "#ffffff",
      "selected-text-color": "#ffffff",
      "bold": true
    },
    "ControlFlow": {
      "text-color": "#ffffff",
      "selected-text-color": "#ffffff",
      "bold": true
    },
    "Function": {
      "text-color": "#decbeb",
      "selected-text-color": "#ffffff"
    },
    "BuiltIn": {
      "text-color": "#decbeb",
      "selected-text-color": "#ffffff",
      "bold": true
    },
    "Extension": {
      "text-color": "#c4d5ed",
      "selected-text-color": "#ffffff",
      "bold": true
    },
