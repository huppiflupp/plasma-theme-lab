  "text-styles": {
    "Normal": {
      "text-color": "#000000",
      "selected-text-color": "#000000",
      "bold": false,
      "italic": false,
      "underline": false,
      "strike-through": false
    },
    "Keyword": {
      "text-color": "#000000",
      "selected-text-color": "#000000",
      "bold": true
    },
    "ControlFlow": {
      "text-color": "#000000",
      "selected-text-color": "#000000",
      "bold": true
    },
    "Function": {
      "text-color": "#7a2fb0",
      "selected-text-color": "#000000"
    },
