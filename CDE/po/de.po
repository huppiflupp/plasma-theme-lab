#: frontpanel/contents/ui/configLaunchers.qml:266
msgid ""
"\"Default …\" entries follow the applications chosen in System Settings › "
"Default Applications. A custom command runs through the shell; app:<desktop "
"id> starts an installed application."
msgstr ""
