#cloud-config
# cloud-init for the Ubuntu test VM. build-vm-ubuntu.sh replaces
# SSH_PUBKEY_PLACEHOLDER with id_lab.pub.
#
# The goal is the same state as in the Fedora VM after provision.sh:
# user tester (password tester, sudo without password), autologin into
# Plasma, no screen lock, marker /etc/plasma-lab-ready.

hostname: ubuntu-lab
locale: de_DE.UTF-8
timezone: Europe/Berlin
keyboard:
  layout: de

users:
  - name: tester
    gecos: Tester
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: false
    ssh_authorized_keys:
      - SSH_PUBKEY_PLACEHOLDER
chpasswd:
  expire: false
  users:
    - {name: tester, password: tester, type: text}
ssh_pwauth: false

package_update: true
package_upgrade: true
packages:
  - qemu-guest-agent
  - kubuntu-desktop
  - language-pack-kde-de
  - libxml2-utils
  - imagemagick
  - rsync

runcmd:
  - systemctl enable --now qemu-guest-agent
  # The cloud image boots without a menu, without a splash and with the console on
  # ttyS0. For testing GRUB and Plymouth themes it has to look like
  # a normal desktop installation: menu briefly visible, "quiet splash".
  - rm -f /etc/default/grub.d/50-cloudimg-settings.cfg
  - sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"/; s/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=menu/; s/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=3/' /etc/default/grub
  - update-grub
  - update-initramfs -u
  # Autologin. Depending on the Plasma version, SDDM or the new
  # plasma-login-manager is responsible - handle both, like provision.sh.
  - |
    if [ -f /usr/lib/systemd/system/plasmalogin.service ]; then
        mkdir -p /etc/plasmalogin.conf.d
        printf '[Autologin]\nUser=tester\nSession=plasma\nRelogin=true\n' > /etc/plasmalogin.conf.d/10-autologin.conf
        echo plasmalogin > /etc/plasma-lab-dm
    else
        # 99, not 10: Kubuntu ships 20-kubuntu.conf with an empty
        # [Autologin] User= - SDDM reads alphabetically, the later one wins.
        mkdir -p /etc/sddm.conf.d
        printf '[Autologin]\nUser=tester\nSession=plasma\nRelogin=true\n' > /etc/sddm.conf.d/99-plasma-lab-autologin.conf
        echo sddm > /etc/plasma-lab-dm
    fi
  - systemctl set-default graphical.target
  # Screen lock, power saving and welcome window off - otherwise
  # 'vmctl.sh shot' only returns black or the lock screen after a few
  # minutes (see provision.sh).
  - |
    sudo -u tester bash <<'USERCFG'
    kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false
    kwriteconfig6 --file kscreenlockerrc --group Daemon --key LockOnResume false
    kwriteconfig6 --file kscreenlockerrc --group Daemon --key Timeout 0
    # Plasma 6 reads powerdevilrc, no longer powermanagementprofilesrc.
    # There a timeout of 0 means "immediately", not "never" - with the old
    # keys the screen went off right after login.
    for p in AC Battery LowBattery; do
        kwriteconfig6 --file powerdevilrc --group "$p" --group Display --key DimDisplayWhenIdle false
        kwriteconfig6 --file powerdevilrc --group "$p" --group Display --key TurnOffDisplayWhenIdle false
        kwriteconfig6 --file powerdevilrc --group "$p" --group SuspendAndShutdown --key AutoSuspendAction 0
    done
    printf '[General]\nLastSeenVersion=99.99.99\n' > ~/.config/plasma-welcomerc
    USERCFG
  # Reference of the unmodified system, as in the Fedora VM.
  - mkdir -p /var/lib/plasma-lab
  - dpkg-query -W -f '${Package}\n' | sort > /var/lib/plasma-lab/ref-packages.txt
  # No second cloud-init run after a snapshot revert.
  - touch /etc/cloud/cloud-init.disabled
  - touch /etc/plasma-lab-ready

power_state:
  mode: reboot
  message: "plasma-lab: setup done, rebooting into the Plasma session"
  timeout: 60
