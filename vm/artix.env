# Test VM number four: Artix Linux with OpenRC (Arch packages, no systemd).
#
# Why: the themes' install scripts have branches for systems without a
# systemd user manager (setsid instead of systemd-run, kquitapp6 instead
# of systemctl --user, no path units). Fedora, EndeavourOS and Ubuntu
# never run them. Artix is Arch with OpenRC: current Plasma, plain
# packages, and - unlike Gentoo - no compiling.
#
# Deterministic: the packages come from Artix's dated archive
# (ARTIX_ARCHIVE_DATE), not from a moving mirror, so a rebuild installs
# the same versions. To move on, change the date and rebuild (or point
# /etc/pacman.d/mirrorlist in the guest to a later date, see
# build-vm-artix.sh).
#
#   ./build-vm-artix.sh
#   LAB_ENV=artix.env ./vmctl.sh status

LIBVIRT_URI="qemu:///system"
VM_NAME="artix-lab"
VM_RAM_MB=6144
VM_VCPUS=4
VM_DISK_GB=40
VM_DISK="/data/vm/images/${VM_NAME}.qcow2"
VM_NETWORK="default"
VM_OSINFO="archlinux"

ARTIX_ISO_URL="https://iso.artixlinux.org/iso/artix-base-openrc-20260813-x86_64.iso"
ARTIX_SUMS_URL="https://iso.artixlinux.org/iso/sha256sums"
ARTIX_ISO="/data/vm/iso/artix/artix-base-openrc-20260813-x86_64.iso"
ARTIX_ARCHIVE_DATE="2026/10/25"

VM_USER="tester"
VM_SSH_KEY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/id_lab"
# The tester's password (for sudo it is not needed: NOPASSWD) is generated
# at build time into this git-ignored file.
VM_PASSWORD_FILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.artix-lab.password"
SSH_OPTS="-i $VM_SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5 -o BatchMode=yes"
