# Test-VM Nummer drei: Ubuntu 26.04 LTS mit KDE Plasma (= Kubuntu).
#
# Wozu: Vor dem Veroeffentlichen soll das Theme auch auf der Distribution
# laufen, die die meisten Nutzer haben. Ubuntu LTS bringt ein aelteres
# Plasma mit als Fedora 44 und EndeavourOS - genau die Luecke, die
# eos.env offen laesst ("Fuer alte Frameworks braeuchte es Kubuntu LTS").
#
# "Standard-Ubuntu" mit GNOME waere sinnlos: ohne Plasma gibt es nichts,
# worauf ein Plasma-Theme wirken koennte. Gebaut wird deshalb aus dem
# Ubuntu-Cloud-Image plus kubuntu-desktop - dieselben Pakete wie bei
# einer Kubuntu-Installation, aber per cloud-init ohne Klickarbeit.
#
#   ./build-vm-ubuntu.sh
#   LAB_ENV=ubuntu.env ./vmctl.sh status

LIBVIRT_URI="qemu:///system"
VM_NAME="ubuntu-lab"
VM_RAM_MB=6144
VM_VCPUS=4
VM_DISK_GB=40
VM_DISK="/data/vm/images/${VM_NAME}.qcow2"
VM_NETWORK="default"
VM_OSINFO="ubuntu25.10"   # osinfo-db kennt 26.04 noch nicht; 25.10 passt

UBUNTU_IMG_URL="https://cloud-images.ubuntu.com/releases/26.04/release/ubuntu-26.04-server-cloudimg-amd64.img"
UBUNTU_SUMS_URL="https://cloud-images.ubuntu.com/releases/26.04/release/SHA256SUMS"
UBUNTU_IMG="/data/vm/iso/ubuntu-26.04-server-cloudimg-amd64.img"

VM_USER="tester"
VM_SSH_KEY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/id_lab"
SSH_OPTS="-i $VM_SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5 -o BatchMode=yes"
