# Test VM number three: Ubuntu 26.04 LTS with KDE Plasma (= Kubuntu).
#
# Why: before publishing, the theme should also run on the distribution
# most users have. Ubuntu LTS ships an older
# Plasma than Fedora 44 and EndeavourOS - exactly the gap that
# eos.env leaves open ("Old Frameworks would need Kubuntu LTS").
#
# "Standard Ubuntu" with GNOME would be pointless: without Plasma there is nothing
# a Plasma theme could act on. So it is built from the
# Ubuntu cloud image plus kubuntu-desktop - the same packages as
# a Kubuntu installation, but via cloud-init without clicking through.
#
#   ./build-vm-ubuntu.sh
#   LAB_ENV=ubuntu.env ./vmctl.sh status

LIBVIRT_URI="qemu:///system"
VM_NAME="ubuntu-lab"
VM_RAM_MB=6144
VM_VCPUS=4
VM_DISK_GB=40
VM_DISK="/data/vm/images/${VM_NAME}.qcow2"
VM_NETWORK="default"
VM_OSINFO="ubuntu25.10"   # osinfo-db does not know 26.04 yet; 25.10 fits

UBUNTU_IMG_URL="https://cloud-images.ubuntu.com/releases/26.04/release/ubuntu-26.04-server-cloudimg-amd64.img"
UBUNTU_SUMS_URL="https://cloud-images.ubuntu.com/releases/26.04/release/SHA256SUMS"
UBUNTU_IMG="/data/vm/iso/ubuntu-26.04-server-cloudimg-amd64.img"

VM_USER="tester"
VM_SSH_KEY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/id_lab"
SSH_OPTS="-i $VM_SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5 -o BatchMode=yes"
