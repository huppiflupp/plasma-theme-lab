# Test-VM Nummer zwei: EndeavourOS (Arch-Familie).
#
# Wozu eine zweite Maschine, wo die Fedora-VM doch laeuft: install-grub.sh
# und install-plymouth.sh haben Zweige, die auf Fedora nie ausgefuehrt
# werden - /boot/grub statt /boot/grub2, mkinitcpio statt dracut,
# /usr/lib/plymouth statt /usr/lib64. Ungetestete Zweige in einem Skript,
# das den Bootloader anfasst, sind die unangenehmste Sorte.
#
# Was sie NICHT leistet: das alte KDE nachstellen, aus dem die erste
# Community-Meldung kam. EndeavourOS ist Rolling Release und damit eher
# neuer als Fedora. Fuer alte Frameworks braeuchte es Kubuntu LTS oder
# Debian stable.
#
# Aufgerufen wird sie ueber LAB_ENV:
#   LAB_ENV=eos.env ./vmctl.sh status

LIBVIRT_URI="qemu:///system"
VM_NAME="eos-lab"
VM_RAM_MB=6144
VM_VCPUS=4
VM_DISK_GB=40
# Bewusst auf /data und nicht neben der Fedora-VM: auf der Systemplatte
# sind noch 234 GB frei, auf /data 1,5 TB.
VM_DISK="/data/vm/images/${VM_NAME}.qcow2"
VM_ISO="/data/vm/iso/EndeavourOS_Titan-Neo-2026.04.27.iso"
VM_NETWORK="default"
VM_OSINFO="archlinux"

VM_USER="tester"
VM_SSH_KEY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/id_lab"
SSH_OPTS="-i $VM_SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5 -o BatchMode=yes"
