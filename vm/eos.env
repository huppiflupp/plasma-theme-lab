# Test VM number two: EndeavourOS (Arch family).
#
# Why a second machine when the Fedora VM works: install-grub.sh
# and install-plymouth.sh have branches that never run on Fedora
# - /boot/grub instead of /boot/grub2, mkinitcpio instead of dracut,
# /usr/lib/plymouth instead of /usr/lib64. Untested branches in a script
# that touches the bootloader are the nastiest kind.
#
# What it does NOT do: reproduce the old KDE that the first
# community report came from. EndeavourOS is a rolling release and thus rather
# newer than Fedora. Old Frameworks would need Kubuntu LTS or
# Debian stable.
#
# It is selected via LAB_ENV:
#   LAB_ENV=eos.env ./vmctl.sh status

LIBVIRT_URI="qemu:///system"
VM_NAME="eos-lab"
VM_RAM_MB=6144
VM_VCPUS=4
VM_DISK_GB=40
# Deliberately on /data and not next to the Fedora VM: the system disk
# has 234 GB free, /data 1.5 TB.
VM_DISK="/data/vm/images/${VM_NAME}.qcow2"
VM_ISO="/data/vm/iso/EndeavourOS_Titan-Neo-2026.04.27.iso"
VM_NETWORK="default"
VM_OSINFO="archlinux"

VM_USER="tester"
VM_SSH_KEY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/id_lab"
SSH_OPTS="-i $VM_SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5 -o BatchMode=yes"
