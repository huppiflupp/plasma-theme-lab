# Zentrale Konfiguration der Test-VM. Wird von allen vm/*.sh eingelesen.

LIBVIRT_URI="qemu:///system"
VM_NAME="plasma-lab"
VM_RAM_MB=6144
VM_VCPUS=4
VM_DISK_GB=40
VM_DISK="/data/vm/images/${VM_NAME}.qcow2"   # seit 25.09.2026 auf /data (vorher ~/.local/share/libvirt/images, dort noch ein Symlink)
VM_NETWORK="default"
VM_OSINFO="fedora43"   # osinfo-db kennt f44 noch nicht; f43-Profil passt

INSTALL_URL="https://download.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/os/"

# Gast-Zugang
VM_USER="tester"
VM_SSH_KEY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/id_lab"
# BatchMode=yes ist wichtig: waehrend der Installation laeuft im Anaconda-
# Umfeld bereits ein sshd (inst.sshd), der unseren Schluessel nicht kennt.
# Ohne BatchMode fragt ssh dann nach einem Passwort und blockiert - ein
# Skript, das auf die VM wartet, haengt an dieser Stelle fest.
SSH_OPTS="-i $VM_SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5 -o BatchMode=yes"
