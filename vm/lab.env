# Central configuration of the test VM. Read by all vm/*.sh.

LIBVIRT_URI="qemu:///system"
VM_NAME="plasma-lab"
VM_RAM_MB=6144
VM_VCPUS=4
VM_DISK_GB=40
VM_DISK="/data/vm/images/${VM_NAME}.qcow2"   # on /data since 25.09.2026 (previously ~/.local/share/libvirt/images, a symlink remains there)
VM_NETWORK="default"
VM_OSINFO="fedora43"   # osinfo-db does not know f44 yet; the f43 profile fits

INSTALL_URL="https://download.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/os/"

# Guest access
VM_USER="tester"
VM_SSH_KEY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/id_lab"
# BatchMode=yes is important: during installation an sshd (inst.sshd) is
# already running in the Anaconda environment, and it does not know our key.
# Without BatchMode, ssh then asks for a password and blocks - a
# script waiting for the VM gets stuck at this point.
SSH_OPTS="-i $VM_SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5 -o BatchMode=yes"
