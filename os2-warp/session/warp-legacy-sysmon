#!/usr/bin/env python3
"""Give the System Monitor's charts the colours of a Warp Legacy variant.

    warp-legacy-sysmon <look-and-feel id>   e.g. org.warplegacy.neon.desktop
    warp-legacy-sysmon --reset              take our colours back out

Why a script: every sensor face asks Charts.ColorGradientSource for colours
(ksysguard/faces/SensorFace.qml): the highlight colour, its hue turned by
360/n for n sensors. Neon's blue selection thus gave orange disks and an
orange/pink/green network legend. Once a page is saved, the colours are
stored per sensor in its [Face-…][SensorColors] group and no longer follow
the colour scheme at all. Pages never saved (History, until edited) are
regenerated on every start, so there is nothing to change but to save one.

What it does:
- In every saved page (~/.local/share/plasma-systemmonitor/*.page) it sets
  the colours of the variant's palette, but only where the colour was not
  chosen by the user: ours (either variant) or one Plasma generated, which
  has the saturation and value of some colour scheme's highlight.
- A system page with sensors and no saved copy (History) is copied as it
  is, our colours appended. The copy it started from is kept in
  warp-legacy-install/sysmon-seeds: as long as the user has not changed the
  page, --reset deletes it again and a newer system page replaces it (the
  System Monitor would otherwise migrate it to "(Old Version)").
- Sensors behind patterns (disk/(?!all).*/used) are looked up in ksystemstats
  over D-Bus, so disks and network cards get their colours before the page
  is first shown.
Pages already open in a running System Monitor change on its next start.
"""
import colorsys
import json
import os
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
DATA = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
LOCAL = DATA / "plasma-systemmonitor"
SEEDS = DATA / "warp-legacy-install/sysmon-seeds"
DATA_DIRS = [Path(d) for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
COLORS_GROUP = re.compile(r"^Face-[^\]]*\]\[SensorColors$")
SENSORS_GROUP = re.compile(r"^(Face-[^\]]*)\]\[Sensors$")


def palettes():
    out = {}
    for line in (HERE / "sysmon-colors").read_text().splitlines():
        lnf, *colors = line.split()
        out[lnf] = [tuple(int(c[i:i + 2], 16) for i in (1, 3, 5)) for c in colors]
    return out


def unescape(value):   # KConfig's escapes, enough for JSON lists of regexes
    def one(m):
        e = m.group(1)
        if e.startswith("x") and len(e) == 3:
            return chr(int(e[1:], 16))
        return {"s": " ", "t": "\t", "n": "\n", "r": "\r"}.get(e, e)
    return re.sub(r"\\(x[0-9a-fA-F]{2}|.)", one, value)


def rgb(value):
    value = value.strip()
    if value.startswith("#") and len(value) >= 7:
        return tuple(int(value[i:i + 2], 16) for i in (1, 3, 5))
    try:
        parts = [int(p) for p in value.split(",")]
    except ValueError:
        return None
    return tuple(parts[:3]) if len(parts) >= 3 else None


def parse(text):
    """[[group or None, [lines]]], lines kept verbatim."""
    groups = [[None, []]]
    for line in text.splitlines():
        if line.startswith("[") and line.rstrip().endswith("]"):
            groups.append([line.strip()[1:-1], []])
        else:
            groups[-1][1].append(line)
    return groups


def render(groups):
    out = []
    for name, lines in groups:
        if name is not None:
            out.append(f"[{name}]")
        out.extend(lines)
    return "\n".join(out).rstrip("\n") + "\n"


def entries(lines):
    pairs = (line.partition("=") for line in lines if not line.startswith("#"))
    return {k.strip(): v for k, sep, v in pairs if sep}


def without_colors(text):
    return render([g for g in parse(text) if g[0] is None or not COLORS_GROUP.match(g[0])]).rstrip()


def highlights():
    """Saturation and value of every installed scheme's selection colour:
    Plasma's generated colours keep those two and only turn the hue."""
    found = {(61, 174, 233)}   # Breeze, Kirigami's fallback
    files = [CONFIG / "kdeglobals"] + [p for d in [DATA] + DATA_DIRS for p in (d / "color-schemes").glob("*.colors")]
    for f in files:
        try:
            group = None
            for line in f.read_text(errors="replace").splitlines():
                if line.startswith("["):
                    group = line.strip()
                elif group == "[Colors:Selection]" and line.startswith("BackgroundNormal="):
                    c = rgb(line.split("=", 1)[1])
                    if c:
                        found.add(c)
        except OSError:
            pass
    return {hsv(c)[1:] for c in found}


def hsv(c):
    return colorsys.rgb_to_hsv(*(x / 255 for x in c))


def live_sensors():
    try:
        out = subprocess.run(["dbus-send", "--session", "--print-reply", "--dest=org.kde.ksystemstats1",
                              "/org/kde/ksystemstats1", "org.kde.ksystemstats1.allSensors"],
                             capture_output=True, text=True, timeout=15).stdout
    except (OSError, subprocess.SubprocessError):
        return set()
    lines = out.splitlines()
    return {m.group(1) for a, b in zip(lines, lines[1:]) if a.strip() == "dict entry("
            for m in [re.match(r'\s*string "(.*)"$', b)] if m}


def natural(s):
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", s)]


def order(patterns, known):
    """The face's sensors in the order it numbers them: pattern by pattern."""
    ids = []
    for p in patterns:
        if not re.search(r"[\\()\[\]*+?|^$.]", p.replace("/", "")):
            if p not in ids:
                ids.append(p)   # a plain id: coloured even if absent right now
            continue
        try:
            rx = re.compile(p)
        except re.error:
            continue
        ids += sorted((k for k in known if k not in ids and rx.fullmatch(k)), key=natural)
    return ids


def system_page(name):
    for d in DATA_DIRS:
        p = d / "plasma-systemmonitor" / name
        if p.is_file():
            return p
    return None


def face_patterns(groups, fallback):
    faces = {}
    for source in (fallback, groups):   # the saved page wins
        for name, lines in source:
            m = name and SENSORS_GROUP.match(name)
            if m and "highPrioritySensorIds" in entries(lines):
                try:
                    faces[m.group(1)] = json.loads(unescape(entries(lines)["highPrioritySensorIds"]))
                except ValueError:
                    pass
    return faces


def recolor(text, fallback_text, palette, ours, generated, live):
    groups = parse(text)
    fallback = parse(fallback_text) if fallback_text else []
    for face, patterns in face_patterns(groups, fallback).items():
        name = f"{face}][SensorColors"
        group = next((g for g in groups if g[0] == name), None)
        saved = entries(group[1]) if group else {}
        ids = order(patterns, set(saved) | live)
        ids += [k for k in saved if k not in ids]
        colors = dict(saved)
        for i, sensor in enumerate(ids):
            c = rgb(saved[sensor]) if sensor in saved else None
            if c is None or c in ours or any(abs(hsv(c)[1] - s) < 0.012 and abs(hsv(c)[2] - v) < 0.012
                                             for s, v in generated):
                colors[sensor] = "%d,%d,%d" % palette[i % len(palette)]
        if not colors or colors == saved:
            continue
        lines = [f"{k}={v}" for k, v in sorted(colors.items())] + [""]
        if group:
            group[1] = lines
        else:
            if groups[-1][1] and groups[-1][1][-1].strip():
                groups[-1][1].append("")
            groups.append([name, lines])
    return render(groups)


def write(path, text, mode=0o600):
    tmp = path.with_name(path.name + ".warp-tmp")
    tmp.write_text(text)
    os.chmod(tmp, path.stat().st_mode & 0o777 if path.exists() else mode)
    os.replace(tmp, path)


def apply(lnf):
    all_palettes = palettes()
    if lnf not in all_palettes:
        return
    palette = all_palettes[lnf]
    ours = {c for p in all_palettes.values() for c in p}
    generated = highlights()
    live = live_sensors()
    LOCAL.mkdir(parents=True, exist_ok=True)
    names = {p.name for p in LOCAL.glob("*.page")}
    for d in DATA_DIRS:
        names |= {p.name for p in (d / "plasma-systemmonitor").glob("*.page") if not p.name.startswith("old-")}
    for name in sorted(names):
        local, system, seed = LOCAL / name, system_page(name), SEEDS / name
        system_text = system.read_text() if system else ""
        if local.exists():
            text = local.read_text()
            # Our untouched copy of an older system page: start again from the new one.
            if seed.exists() and system_text and without_colors(text) == seed.read_text().rstrip() \
                    and seed.read_text() != system_text:
                text = system_text
                seed.write_text(system_text)
        elif system_text:
            text = system_text
        else:
            continue
        new = recolor(text, system_text, palette, ours, generated, live)
        if local.exists() and new == local.read_text():
            continue
        if not local.exists():
            if new == render(parse(system_text)):
                continue   # no sensors to colour: leave the page to Plasma
            SEEDS.mkdir(parents=True, exist_ok=True)
            seed.write_text(system_text)
        write(local, new)


def reset():
    if not LOCAL.is_dir():
        return
    ours = {c for p in palettes().values() for c in p}
    for local in LOCAL.glob("*.page"):
        text = local.read_text()
        seed = SEEDS / local.name
        if seed.exists() and without_colors(text) == seed.read_text().rstrip():
            local.unlink()   # our copy, unchanged by the user
            continue
        groups = []
        for name, lines in parse(text):
            if name and COLORS_GROUP.match(name):
                kept = [l for l in lines if rgb(l.partition("=")[2]) not in ours or "=" not in l]
                if not any(l.strip() for l in kept):
                    continue   # Plasma generates them again from its highlight
                lines = kept
            groups.append([name, lines])
        new = render(groups)
        if new != text:
            write(local, new)
    for seed in SEEDS.glob("*.page") if SEEDS.is_dir() else []:
        seed.unlink()
    if SEEDS.is_dir():
        SEEDS.rmdir()
    # apply() made the folder; empty, it goes again
    try:
        LOCAL.rmdir()
    except OSError:
        pass


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit(__doc__.split("\n\n")[1])
    reset() if sys.argv[1] == "--reset" else apply(sys.argv[1])
