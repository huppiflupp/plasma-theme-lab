#!/bin/sh
# warp-wallpaper <package id>: give every desktop the variant's wallpaper,
# unless the user chose one from outside Warp Legacy. Neon's pictures do
# not belong under the classic grey and the other way round, so a Warp
# Legacy picture is replaced (the user's remark, 21.10.2026): a global theme
# applied without its layout leaves the wallpaper as it was.
want=$1
neon_pictures="neon-|dunkel-|wirbel-nacht-|warp-antrieb|schiefer-warp"
config="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
current=$(grep -m1 '^Image=' "$config" 2>/dev/null | cut -d= -f2-)
case "$current" in
    ""|*org.warplegacy.*) ;;
    *) exit 0 ;;
esac
# Within Warp Legacy, keep a picture that already fits the variant.
if [ -n "$current" ]; then
    case "$want" in *neon*|*dunkel*) is_neon=1 ;; *) is_neon= ;; esac
    if printf '%s' "$current" | grep -Eq "$neon_pictures"; then fits=$is_neon; else fits=$([ -z "$is_neon" ] && echo 1); fi
    [ -n "$fits" ] && exit 0
fi
image="file://${XDG_DATA_HOME:-$HOME/.local/share}/wallpapers/$want/"
script="desktops().forEach(function(d) { d.wallpaperPlugin = 'org.kde.image'; d.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General']; d.writeConfig('Image', '$image'); });"
dbus-send --session --print-reply --type=method_call --dest=org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell.evaluateScript string:"$script" >/dev/null 2>&1 || true
