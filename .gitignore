# Cloned KDE references. They do not belong in the repo - anyone who needs
# them fetches them with the commands from the README (each with --depth 1).
reference/

# The theme being reworked has its own repository.
niceos9/

# SSH key of the test VM. Generated by build-vm.sh and must never
# go into the repo - it grants access to the VM.
vm/id_lab
vm/id_lab.pub
vm/.plasma-lab.rendered.ks
vm/.ubuntu-lab.rendered.user-data
vm/*.log
vm/console.log

# Test runs: reports and screenshots are created anew on every run.
tests/runs/
tests/laeufe/

# Generated intermediate files
__pycache__/
*.pyc

# The downloaded third-party icon sets are deliberately NOT in the repo:
# NTLegacy (Chicago95, ~76 MB) and NTLegacySE98 (SE98, ~164 MB).
# Reasons in nt-legacy/ATTRIBUTION.md. In short: Chicago95 has no
# LICENSE file and an unclear origin for its bitmaps; SE98 has one
# (GPL-2.0), but its own README calls it a copy-paste fork of
# Chicago95 with material from the Microsoft Memphis project - a
# licence only covers what the licensor created themselves.
# Third-party material with an open licensing question does not belong
# in a repository that someone passes on.
#
# Fetch with:  nt-legacy/fetch-icons.sh [chicago95|se98|both]
nt-legacy/icons/

# Finished archives for the KDE Store. They are built reproducibly from
# the tree with tools/make-package.sh - binary data does not belong in the repo.
dist/

# Night version of the icon set. A pure derivative of NTLegacyIcons -
# the same images, only with breeze-dark as the fallback chain. Created in
# build.py (and in install.sh if it is still missing there); in the repo it
# would be a 184 KB duplicate without content of its own.
nt-legacy/icons-nt/NTLegacyIconsNacht/

# The raw material for the backgrounds: 378 MB of PNG from the image model.
# The repository gets the finished packages under nt-legacy/wallpapers/ -
# the same images as JPEG, 69 MB in total. The way from here to there
# is tools/make-backgrounds.py.
wallpaper/

# Working state for the terminal cockpit (plan, events, notes).
# Belongs to the session, not to the theme.
.cockpit/

# Reference screenshots of OS/2 Warp (copyrighted). Fetch with
# os2-warp/fetch-reference.sh.
os2-warp/reference/

# Warp Legacy: build/ is generated by os2-warp/build.py (it carries the
# wallpaper JPEGs a second time); the icon preview by icons_neon.py.
os2-warp/build/
os2-warp/build-icons-preview/
# Work files of the 1:1 icon set (crops, img2img outputs, ~100 MB); the
# masters in os2-warp/icons-neon2026/masters/ are what the build reads.
os2-warp/icons-neon2026/_work/
os2-warp/build-icons-preview-2026/
os2-warp/build-icons-preview-classic/
