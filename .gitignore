# Geklonte KDE-Referenzen. Sie gehoeren nicht ins Repo - wer sie braucht,
# holt sie mit den Kommandos aus der README (jeweils --depth 1).
reference/

# Das zu ueberarbeitende Theme hat ein eigenes Repository.
niceos9/

# SSH-Schluessel der Test-VM. Wird von build-vm.sh erzeugt und darf
# niemals ins Repo - er gibt Zugang zur VM.
vm/id_lab
vm/id_lab.pub
vm/.plasma-lab.rendered.ks
vm/.ubuntu-lab.rendered.user-data
vm/*.log
vm/console.log

# Testlaeufe: Berichte und Screenshots entstehen bei jedem Durchlauf neu.
tests/laeufe/

# Erzeugte Zwischenstaende
__pycache__/
*.pyc

# Die nachgeladenen Fremdsaetze liegen bewusst NICHT im Repo:
# NTLegacy (Chicago95, ~76 MB) und NTLegacySE98 (SE98, ~164 MB).
# Begruendung in nt-legacy/ATTRIBUTION.md. Kurz: Chicago95 hat keine
# LICENSE-Datei und eine ungeklaerte Bitmap-Herkunft; SE98 hat eine
# (GPL-2.0), nennt sich in der eigenen README aber einen Copy-Paste-Fork
# von Chicago95 mit Material aus dem MicroSoft-Memphis-Projekt - eine
# Lizenz deckt nur, was der Setzende selbst geschaffen hat.
# Fremdmaterial mit offener Lizenzfrage gehoert nicht in ein Repository,
# das jemand weitergibt.
#
# Holen mit:  nt-legacy/fetch-icons.sh [chicago95|se98|beide]
nt-legacy/icons/

# Fertige Archive fuer den KDE Store. Sie entstehen reproduzierbar aus
# dem Baum mit tools/mach-paket.sh - Binaerdaten gehoeren nicht ins Repo.
dist/

# Nachtfassung des Symbolsatzes. Reine Ableitung aus NTLegacyIcons -
# dieselben Bilder, nur breeze-dark als Rueckfallkette. Entsteht in
# build.py (und in install.sh, falls sie dort noch fehlt); im Repo waere
# sie ein 184 KB grosses Duplikat ohne eigenen Inhalt.
nt-legacy/icons-nt/NTLegacyIconsNacht/

# Das Rohmaterial der Hintergruende: 378 MB PNG aus dem Bildmodell.
# Ins Repository gehen die fertigen Pakete unter nt-legacy/wallpapers/ -
# dieselben Bilder als JPEG, zusammen 69 MB. Der Weg von hier nach dort
# ist tools/mach-hintergruende.py.
wallpaper/

# Arbeitsstand fuer das Terminal-Cockpit (Plan, Ereignisse, Hinweise).
# Gehoert zur Sitzung, nicht zum Theme.
.cockpit/
